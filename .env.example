# ─────────────────────────────────────────────────────────────────────────────
# VOVIAN — environment reference. Each app has its own .env.example:
#   apps/storefront/.env.example   (Nuxt, public keys only)
#   apps/admin/.env.example        (React, public keys only)
#   supabase/functions/.env.example (edge function secrets)
# This root file documents values used by scripts. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Used by the Supabase CLI to apply migrations and deploy edge functions to the
# hosted project (supabase db push / functions deploy). Never commit real values.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Used only by scripts/create-admin.mjs, from a trusted machine.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_URL=https://admin.yourbrand.com

# Playwright against a deployed preview (optional)
E2E_BASE_URL=
