# Edge function secrets. Locally: copy to supabase/functions/.env
# In production: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# Comma-separated origins allowed to call the functions (storefront + admin)
ALLOWED_ORIGINS=https://www.yourbrand.com,https://admin.yourbrand.com
STOREFRONT_URL=https://www.yourbrand.com
ADMIN_URL=https://admin.yourbrand.com

# Transactional email (optional — without it emails are logged, not sent)
RESEND_API_KEY=
EMAIL_FROM=VOVIAN <orders@yourbrand.com>
