# VOVIAN storefront (Nuxt). Public values only — never put a service role / secret key here.
SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key from `supabase status`
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Defaults to $SUPABASE_URL/functions/v1
NUXT_PUBLIC_FUNCTIONS_URL=
# true when Supabase Storage image transformations are available (Pro plan / local)
NUXT_PUBLIC_IMAGE_TRANSFORMS=false
